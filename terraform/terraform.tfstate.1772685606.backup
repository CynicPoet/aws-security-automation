    {
      "module": "module.step_functions",
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "security_remediation",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:us-east-1:024848485894:stateMachine:SecurityRemediationStateMachine",
            "creation_date": "2026-03-05T04:02:36Z",
            "definition": "{\n  \"Comment\": \"Security Automation: detect -\u003e AI analyze -\u003e auto-remediate or escalate -\u003e verify -\u003e update\",\n  \"StartAt\": \"ParseFinding\",\n  \"States\": {\n\n    \"ParseFinding\": {\n      \"Type\": \"Pass\",\n      \"Comment\": \"Extract first finding from EventBridge event and normalize\",\n      \"Parameters\": {\n        \"finding_id.$\": \"$.detail.findings[0].Id\",\n        \"product_arn.$\": \"$.detail.findings[0].ProductArn\",\n        \"resource_type.$\": \"$.detail.findings[0].Resources[0].Type\",\n        \"resource_id.$\": \"$.detail.findings[0].Resources[0].Id\",\n        \"resource_arn.$\": \"$.detail.findings[0].Resources[0].Id\",\n        \"severity.$\": \"$.detail.findings[0].Severity.Label\",\n        \"title.$\": \"$.detail.findings[0].Title\",\n        \"description.$\": \"$.detail.findings[0].Description\",\n        \"region.$\": \"$.region\",\n        \"account_id.$\": \"$.account\"\n      },\n      \"ResultPath\": \"$.finding\",\n      \"Next\": \"AIAnalysis\"\n    },\n\n    \"AIAnalysis\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-ai-analyzer\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\"\n      },\n      \"ResultPath\": \"$.ai_analysis\",\n      \"TimeoutSeconds\": 90,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.TooManyRequestsException\"],\n          \"IntervalSeconds\": 5,\n          \"MaxAttempts\": 2,\n          \"BackoffRate\": 2\n        }\n      ],\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"HandleError\"\n        }\n      ],\n      \"Next\": \"IsFalsePositive\"\n    },\n\n    \"IsFalsePositive\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.ai_analysis.is_false_positive\",\n          \"BooleanEquals\": true,\n          \"Next\": \"SuppressFalsePositive\"\n        }\n      ],\n      \"Default\": \"IsSafeToAutoRemediate\"\n    },\n\n    \"SuppressFalsePositive\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": {\n        \"event_type\": \"FALSE_POSITIVE\",\n        \"message\": \"AI determined finding is a false positive - suppressing\",\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\"\n      },\n      \"ResultPath\": null,\n      \"Next\": \"EndFalsePositive\"\n    },\n\n    \"EndFalsePositive\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"IsSafeToAutoRemediate\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.ai_analysis.safe_to_auto_remediate\",\n          \"BooleanEquals\": true,\n          \"Next\": \"DetermineResourceType\"\n        }\n      ],\n      \"Default\": \"NotifyAdmin\"\n    },\n\n    \"DetermineResourceType\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.finding.resource_type\",\n          \"StringMatches\": \"*S3*\",\n          \"Next\": \"RemediateS3\"\n        },\n        {\n          \"Variable\": \"$.finding.resource_type\",\n          \"StringMatches\": \"*Iam*\",\n          \"Next\": \"RemediateIAM\"\n        },\n        {\n          \"Variable\": \"$.finding.resource_type\",\n          \"StringMatches\": \"*SecurityGroup*\",\n          \"Next\": \"RemediateVPC\"\n        }\n      ],\n      \"Default\": \"EndUnsupported\"\n    },\n\n    \"EndUnsupported\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"RemediateS3\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-s3-remediation\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\"\n      },\n      \"ResultPath\": \"$.remediation_result\",\n      \"TimeoutSeconds\": 90,\n      \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 2, \"BackoffRate\": 2}],\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"VerifyRemediation\"\n    },\n\n    \"RemediateIAM\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-iam-remediation\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\"\n      },\n      \"ResultPath\": \"$.remediation_result\",\n      \"TimeoutSeconds\": 90,\n      \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 2, \"BackoffRate\": 2}],\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"VerifyRemediation\"\n    },\n\n    \"RemediateVPC\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-vpc-remediation\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\"\n      },\n      \"ResultPath\": \"$.remediation_result\",\n      \"TimeoutSeconds\": 90,\n      \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 2, \"BackoffRate\": 2}],\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"VerifyRemediation\"\n    },\n\n    \"NotifyAdmin\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke.waitForTaskToken\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-notification\",\n        \"Payload\": {\n          \"finding.$\": \"$.finding\",\n          \"ai_analysis.$\": \"$.ai_analysis\",\n          \"task_token.$\": \"$$.Task.Token\"\n        }\n      },\n      \"ResultPath\": \"$.approval_result\",\n      \"HeartbeatSeconds\": 3600,\n      \"TimeoutSeconds\": 3660,\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.HeartbeatTimeout\", \"States.Timeout\"],\n          \"ResultPath\": \"$.timeout_error\",\n          \"Next\": \"EndTimeout\"\n        },\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"HandleError\"\n        }\n      ],\n      \"Next\": \"RouteAdminDecision\"\n    },\n\n    \"RouteAdminDecision\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.approval_result.admin_decision\",\n          \"StringEquals\": \"APPROVED\",\n          \"Next\": \"ExecuteApprovedPlaybook\"\n        },\n        {\n          \"Variable\": \"$.approval_result.admin_decision\",\n          \"StringEquals\": \"REJECTED\",\n          \"Next\": \"EndRejected\"\n        },\n        {\n          \"Variable\": \"$.approval_result.admin_decision\",\n          \"StringEquals\": \"MANUAL\",\n          \"Next\": \"EndManual\"\n        }\n      ],\n      \"Default\": \"HandleError\"\n    },\n\n    \"ExecuteApprovedPlaybook\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.finding.resource_type\",\n          \"StringMatches\": \"*S3*\",\n          \"Next\": \"ApprovedRemediateS3\"\n        },\n        {\n          \"Variable\": \"$.finding.resource_type\",\n          \"StringMatches\": \"*Iam*\",\n          \"Next\": \"ApprovedRemediateIAM\"\n        },\n        {\n          \"Variable\": \"$.finding.resource_type\",\n          \"StringMatches\": \"*SecurityGroup*\",\n          \"Next\": \"ApprovedRemediateVPC\"\n        }\n      ],\n      \"Default\": \"EndUnsupported\"\n    },\n\n    \"ApprovedRemediateS3\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-s3-remediation\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\",\n        \"approved_action.$\": \"$.approval_result.approved_action\"\n      },\n      \"ResultPath\": \"$.remediation_result\",\n      \"TimeoutSeconds\": 90,\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"VerifyRemediation\"\n    },\n\n    \"ApprovedRemediateIAM\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-iam-remediation\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\",\n        \"approved_action.$\": \"$.approval_result.approved_action\"\n      },\n      \"ResultPath\": \"$.remediation_result\",\n      \"TimeoutSeconds\": 90,\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"VerifyRemediation\"\n    },\n\n    \"ApprovedRemediateVPC\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-vpc-remediation\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"ai_analysis.$\": \"$.ai_analysis\",\n        \"approved_action.$\": \"$.approval_result.approved_action\"\n      },\n      \"ResultPath\": \"$.remediation_result\",\n      \"TimeoutSeconds\": 90,\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"VerifyRemediation\"\n    },\n\n    \"VerifyRemediation\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:us-east-1:024848485894:function:security-auto-verification\",\n      \"Parameters\": {\n        \"finding.$\": \"$.finding\",\n        \"remediation_result.$\": \"$.remediation_result\"\n      },\n      \"ResultPath\": \"$.verification_result\",\n      \"TimeoutSeconds\": 60,\n      \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.error\", \"Next\": \"HandleError\"}],\n      \"Next\": \"EndSuccess\"\n    },\n\n    \"EndSuccess\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"EndRejected\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"EndManual\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"EndTimeout\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"HandleError\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"PipelineError\",\n      \"Cause\": \"An error occurred - check CloudWatch logs\"\n    }\n  }\n}\n",
            "description": "",
            "encryption_configuration": [
